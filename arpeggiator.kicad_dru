(version 1)
(rule "Component hole spacing"
 (condition "(A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical')) || (B.Type == 'Pad' && (B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical'))")
 (constraint hole_to_hole (min 0.45mm)))
(rule "Component hole to copper"
 (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole') || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole')")
 (constraint hole_clearance (min 0.3mm)))
(rule "Component plated annular ring"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint annular_width (min 0.15mm)))
